{
  "name": "ditch",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "db:link": "npx supabase link",
    "db:push": "npx supabase db push",
    "db:setup": "pnpm db:link && pnpm db:push",
    "db:reset": "npx supabase db reset",
    "db:migrate:new": "npx supabase migration new",
    "db:migrate:status": "npx supabase migration list",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.18.0 <2",
      "ws": ">=8.21.0 <9",
      "engine.io": ">=6.6.7 <7",
      "socket.io-parser": ">=4.2.7 <5",
      "postcss": ">=8.5.23 <9",
      "fast-uri": ">=3.1.6 <4",
      "nanoid@3": ">=3.3.18 <4",
      "browserslist": ">=4.28.7 <5",
      "form-data@4": ">=4.0.6 <5",
      "qs": ">=6.16.0 <7"
    }
  }
}
