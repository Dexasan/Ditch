# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API server
API_PORT=3002

# Realtime server
REALTIME_PORT=3001
WEB_URL=http://localhost:3000

# Relay server
RELAY_PORT=3003
MAX_ACTIVE_STREAMS=4
# Comma-separated dedicated WebSocket relay pool used by /relay/assignment.
RELAY_URLS=ws://localhost:3003

# External encoder ingest (set the same secret on API and relay)
RTMP_INGEST_ENABLED=false
RTMP_INGEST_PORT=1935
INGEST_PUBLIC_URL=rtmp://localhost:1935/live
INGEST_AUTH_SECRET=replace-with-at-least-32-random-characters
INGEST_KEY_TTL_SECONDS=43200

# Cloudflare R2 HLS (all are required; disabled unless explicitly true)
R2_HLS_ENABLED=false
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=ditch-live
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://live.example.com

# LiveKit (optional; Agora remains the default until NEXT_PUBLIC_RTC_PROVIDER changes)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# use ACCESS TOKEN to auth supabase cli to use `pnpm db:` commands
SUPABASE_ACCESS_TOKEN=

# CORS — scopes Vercel preview deployments to your team/username only.
# Find it at: vercel.com/account → Settings → "Your Username" (personal) or Team Settings → Slug.
VERCEL_TEAM_SLUG=your-vercel-team-slug

# Local JWT validation (replaces Supabase HTTP round-trip — see docs/pre-launch.md).
# Find it at: Supabase Dashboard → Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=get-from-supabase-dashboard

# Web app (Next.js — must be prefixed NEXT_PUBLIC_ to be available in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
NEXT_PUBLIC_RELAY_URL=ws://localhost:3003
NEXT_PUBLIC_RTC_PROVIDER=agora
NEXT_PUBLIC_RELAY_DISCOVERY=false
NEXT_PUBLIC_HLS_BASE_URL=
NEXT_PUBLIC_AGORA_APP_ID=your-agora-app-id

# Agora — server-side only (NEVER prefix with NEXT_PUBLIC_)
# App ID lives here too so the token endpoint can read it without exposing the certificate.
AGORA_APP_ID=your-agora-app-id
# App Certificate — enables token auth. Get from Agora Console → Project → Primary Certificate.
# Leave blank to run in testing mode (null tokens). Must be set in production.
AGORA_APP_CERTIFICATE=get-from-agora-console
