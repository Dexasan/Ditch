# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API server
API_PORT=3001

# Realtime server
REALTIME_PORT=3001
WEB_URL=http://localhost:3000

# Relay server
RELAY_PORT=3003

# use ACCESS TOKEN to auth supabase cli to use `pnpm db:` commands
SUPABASE_ACCESS_TOKEN=

# CORS — scopes Vercel preview deployments to your team/username only.
# Find it at: vercel.com/account → Settings → "Your Username" (personal) or Team Settings → Slug.
VERCEL_TEAM_SLUG=your-vercel-team-slug

# Local JWT validation (replaces Supabase HTTP round-trip — see docs/pre-launch.md).
# Find it at: Supabase Dashboard → Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=get-from-supabase-dashboard

# Web app (Next.js — must be prefixed NEXT_PUBLIC_ to be available in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
NEXT_PUBLIC_RELAY_URL=ws://localhost:3003
NEXT_PUBLIC_AGORA_APP_ID=your-agora-app-id

# Agora — server-side only (NEVER prefix with NEXT_PUBLIC_)
# App ID lives here too so the token endpoint can read it without exposing the certificate.
AGORA_APP_ID=your-agora-app-id
# App Certificate — enables token auth. Get from Agora Console → Project → Primary Certificate.
# Leave blank to run in testing mode (null tokens). Must be set in production.
AGORA_APP_CERTIFICATE=get-from-agora-console
