{
  "name": "@ditch/relay",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/index.ts",
    "build": "mkdir -p vendor && curl -L https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz | tar -xJ --strip-components=1 -C vendor --wildcards '*/ffmpeg' && chmod +x vendor/ffmpeg && tsc",
    "start": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "test:browser-encode-policy": "node --import tsx scripts/verify-browser-encode-policy.mjs",
    "test:ingest": "node scripts/verify-rtmp-ingest.mjs",
    "test:ingest:transport": "node scripts/rtmp-transport-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@ditch/db": "workspace:*",
    "node-media-server": "4.2.8",
    "tsx": "^4.23.13",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
