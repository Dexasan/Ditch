{
  "name": "@ditch/relay",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/index.ts",
    "build": "apt-get install -y -qq ffmpeg 2>/dev/null || true && tsc",
    "start": "tsx src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ditch/db": "workspace:*",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "tsx": "^4.0.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.4.0"
  }
}
