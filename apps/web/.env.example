# Web app (Next.js — must be prefixed NEXT_PUBLIC_ to be available in browser)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# optional
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
NEXT_PUBLIC_RELAY_URL=ws://localhost:3003
NEXT_PUBLIC_AGORA_APP_ID=your-agora-app-id

# Required for production password sign-in/signup. Enable hCaptcha in Supabase.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
# Exact media origins for the CSP (when those providers are used).
NEXT_PUBLIC_LIVEKIT_URL=
NEXT_PUBLIC_HLS_BASE_URL=
